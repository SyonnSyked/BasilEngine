{
  "version": 6,
  "configurePresets": [
    {
      "name": "local-dev",
      "displayName": "Local BasilEngine Editor Debug",
      "inherits": "dev",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "C:/path/to/toolchain.cmake",
        "BASIL_RAYLIB_ROOT": "C:/path/to/raylib"
      }
    },
    {
      "name": "local-headless-debug",
      "displayName": "Local BasilEngine Headless Debug",
      "inherits": "headless-debug",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "C:/path/to/toolchain.cmake",
        "BASIL_RAYLIB_ROOT": "C:/path/to/raylib"
      }
    }
  ],
  "buildPresets": [
    { "name": "local-dev", "configurePreset": "local-dev" },
    { "name": "local-headless-debug", "configurePreset": "local-headless-debug" }
  ],
  "testPresets": [
    {
      "name": "local-dev",
      "configurePreset": "local-dev",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "local-headless-debug",
      "configurePreset": "local-headless-debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
